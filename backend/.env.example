# 服务器配置
NODE_ENV=production
PORT=3000

# 数据层驱动：json | mysql（接入正式数据库时改为 mysql，并确保下方 DB_* 齐全）
DB_DRIVER=json

# MySQL数据库配置（仅 DB_DRIVER=mysql 时需要）
DB_HOST=localhost
DB_PORT=3306
DB_USER=review_app
DB_PASSWORD=YourStrongPassword123!
DB_NAME=economic_review

# JWT 配置
# 生产环境必须显式设置强随机密钥：openssl rand -base64 48
JWT_SECRET=your-production-secret-key-change-this-immediately
# 单位：秒。默认 28800 = 8 小时（注意：不是 7d 这种格式）
JWT_EXPIRES_IN=28800
# bcrypt 加密轮数（越大越慢越安全，12 是常用值）
BCRYPT_ROUNDS=12

# CORS：允许跨域访问的前端来源，逗号分隔（GitHub Pages 用 https://121299568.github.io）
CORS_ORIGINS=https://121299568.github.io

# 文件上传配置
UPLOAD_DIR=./uploads
# 单位：MB（config.js 读取 MAX_FILE_SIZE_MB）
MAX_FILE_SIZE_MB=50

# 是否用内置默认账号初始化（生产建议 false，改用 migrate.js 导入）
SEED_DEFAULT_USERS=false

# 登录限流（15 分钟内最多 20 次失败）
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=20

# Redis配置（当前未启用，预留）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
