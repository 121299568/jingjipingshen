# ===== 经济评审管理平台 · 内网部署配置模板 =====
# 说明：运行 setup-intranet.sh 时会自动生成 backend/.env（基于本模板）。
# 本文件仅作参考；如需手动定制，请直接编辑 backend/.env。

NODE_ENV=production

# 监听端口（内网访问地址：http://<本机内网IP>:3000）
PORT=3000

# 安全：请用 `openssl rand -base64 48` 生成后填入；重启后旧登录态失效
JWT_SECRET=__请替换为随机字符串__

# CORS：内网同源部署留空即可
CORS_ORIGINS=

# ============ 数据层驱动 ============
# json  = 文件驱动（默认，零依赖，推荐内网首选；数据存于 backend/data/store.json）
# mysql = 需内网已存在可访问的 MySQL 实例
DB_DRIVER=json

# ---- 以下仅 DB_DRIVER=mysql 时需要 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=review_app
DB_NAME=economic_review
DB_PASSWORD=

# 首次启动是否创建默认账号(admin/admin123)，建议首次启动后改密并设为 false
SEED_DEFAULT_USERS=true

UPLOAD_DIR=/opt/economic-review/backend/uploads
DATA_DIR=/opt/economic-review/backend/data

LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX=20
